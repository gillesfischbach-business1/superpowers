{
  "name": "diddeleng",
  "version": "1.0.0",
  "description": "Diddeleng — a single-player open world of Dudelange, Luxembourg, built from real OSM geometry and EU-DEM terrain.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "pipeline": "node scripts/run-pipeline.mjs",
    "pipeline:qa": "node scripts/run-pipeline.mjs qa",
    "test": "node --test tests/*.test.mjs",
    "import:places": "node scripts/import-places.mjs",
    "serve": "node scripts/serve-forever.mjs --port 5173",
    "pack": "node scripts/pack.mjs",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "three": "^0.187.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
